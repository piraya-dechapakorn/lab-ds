{
  "name": "@piraya.d/ai_designsystem_lab",
  "version": "1.0.0",
  "description": "React + TypeScript design system built on Base UI and Tailwind CSS v4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piraya-dechapakorn/lab-ds.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "base-ui",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:package": "node build/check-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "cn": "^0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.27.7",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
